<Project Sdk="Microsoft.NET.Sdk">

	<!-- General Package Properties -->
	<PropertyGroup>
		<PackageId>ItsLukesMultiplayerMod</PackageId>
		<Version>0.7.3-alpha-colonies.0.11.0</Version>
		<Authors>ItsLuke,Sgt_Lmalas</Authors>
		<Copyright>$(AssemblyCopyright)</Copyright>
	</PropertyGroup>

	<!-- Mod Info, used to generate yaml files on the fly -->
	<PropertyGroup>
		<ModName>ONI Together (Separate Colonies)</ModName>
		<ModStaticID>ONI_Together_SeparateColonies</ModStaticID>
		<ModDescription>Fork of ONI Together (by Lyraedan) with separate colonies on the same asteroid. Disable the original ONI Together while using this.</ModDescription>
		<MinimumSupportedBuild>$(TargetGameVersion)</MinimumSupportedBuild>
		<APIVersion>2</APIVersion>
	</PropertyGroup>

	<!-- Build Properties -->
	<PropertyGroup>
		<ImplicitUsings>false</ImplicitUsings>
		<!--exports the mod to the deployment folder-->
		<IsMod>true</IsMod>
		<!--Generates Yaml files-->
		<GenerateMetadata>true</GenerateMetadata>
		<!--Merges dlls into one, becomes relevant if PLib is added, does not play nice with gDrives transitive nuget requirements-->
		<IsPacked>true</IsPacked>
	</PropertyGroup>

	<PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
		<DefineConstants>OS_WINDOWS</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
		<DefineConstants>OS_LINUX</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="$([MSBuild]::IsOSPlatform('FreeBSD'))">
		<DefineConstants>OS_FREEBSD</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
		<DefineConstants>OS_MAC</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<EmbeddedResource Include="Assets\mod_mascot.png" />
		<EmbeddedResource Include="Assets\oni_together_logo.png" />
		<EmbeddedResource Include="Assets\discord.png" />
		<EmbeddedResource Include="Assets\bundles\playercursor_win.bundle" />
		<EmbeddedResource Include="Assets\bundles\playercursor_mac.bundle" />
		<EmbeddedResource Include="Assets\bundles\playercursor_lin.bundle" />
		<EmbeddedResource Include="Assets\bundles\networkindicators_lin.bundle" />
		<EmbeddedResource Include="Assets\bundles\networkindicators_mac.bundle" />
		<EmbeddedResource Include="Assets\bundles\networkindicators_win.bundle" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Shared\Shared.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="ModAssets\translations\" />
	  <Folder Include="Networking\Visualizers\" />
	  <Folder Include="Networking\Packets\BulkDataPackets\" />
	</ItemGroup>

	<ItemGroup Condition="'$(OfflineBuild)' != 'true'">
	  <PackageReference Include="RiptideNetworking.Riptide" Version="2.2.1" />
		<PackageReference Include="PLib" Version="4.22.0" />
	</ItemGroup>
	<ItemGroup Condition="'$(OfflineBuild)' == 'true'">
		<Reference Include="RiptideNetworking"><HintPath>$(SolutionDir)lib/RiptideNetworking.dll</HintPath><Private>True</Private></Reference>
		<Reference Include="PLib"><HintPath>$(SolutionDir)lib/PLib.dll</HintPath><Private>True</Private></Reference>
	</ItemGroup>

</Project>
